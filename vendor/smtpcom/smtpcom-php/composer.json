{
    "name": "smtpcom/smtpcom-php",
    "description": "Smtp.com SDK provides methods for all API functions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "beberlei/assert": "^3.3.3",
        "php-http/client-common": "^2.7",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5 || ^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "php-http/guzzle7-adapter": "^1.1",
        "psalm/phar": "^6.0",
        "phpstan/phpstan": "^2.1"
    },
    "conflict": {
        "php-http/message": "<1.16"
    },
    "autoload": {
        "psr-4": {
            "SmtpSdk\\": "src/",
            "SmtpSdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "",
        "test-ci": ""
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
